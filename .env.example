# Server settings (defaults to loopback-only 127.0.0.1 for tunnel security)
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=https://bingo.example.com

# Random secret used to sign session cookies (keep private!)
SESSION_SECRET=replace-with-random-secret

# Optional comma-separated emails or provider IDs (e.g. "discord:12345" or "you@example.com")
# If empty, the first user who signs in automatically becomes Host.
HOST_EMAILS=
HOST_IDS=

# Set to "false" in production once Google and/or Discord OAuth is configured.
# When "true", a quick local dev login is shown for testing without OAuth keys.
ALLOW_DEV_LOGIN=false

# Google OAuth2 (https://console.cloud.google.com/auth/clients)
# Authorized redirect URI: https://bingo.example.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth2 (https://discord.com/developers/applications)
# Redirect URI: https://bingo.example.com/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Cloudflare Tunnel token (used by cloudflared; keep in separate tunnel.env on Linux)
CLOUDFLARE_TUNNEL_TOKEN=
